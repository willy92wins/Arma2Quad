diffuse[]={1.0,0.88,0.6,1.0};
forcedDiffuse[]={0.0,0.0,0.0,1.0};
emmisive[]={3.5,2.8,1.8,1.0};
specular[]={0.6,0.5,0.4,1.0};
specularPower=80;
PixelShaderID="Super";
VertexShaderID="Super";
